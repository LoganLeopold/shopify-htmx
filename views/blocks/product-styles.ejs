<%# Shared styles for product sections (main product + featured product). %>
<style>
  .product-section__container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
  }

  @media (max-width: 768px) {
    .product-section__container {
      grid-template-columns: 1fr;
    }
  }

  .product-section__vendor {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .product-section__title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-md);
  }

  .product-section__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .product-description {
    padding-top: var(--space-xl);
    border-top: var(--border-width) solid var(--color-border);
  }

  /* Price */
  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  .price__compare {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-normal);
    color: var(--color-text-muted);
  }

  .price__badge {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15em 0.6em;
    border-radius: 999px;
    border: var(--border-width) solid currentColor;
  }

  .price__badge--sale { color: var(--color-error); }
  .price__badge--sold-out { color: var(--color-text-muted); }

  /* Variant picker */
  .variant-picker {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .variant-picker__option {
    border: 0;
  }

  .variant-picker__legend {
    font-weight: var(--font-weight-medium);
    font-size: var(--text-sm);
    margin-bottom: var(--space-sm);
  }

  .variant-picker__selected {
    font-weight: var(--font-weight-normal);
    color: var(--color-text-muted);
  }

  .variant-picker__values {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .variant-picker__input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .variant-picker__pill {
    display: inline-flex;
    align-items: center;
    min-width: 3rem;
    justify-content: center;
    padding: var(--space-sm) var(--space-md);
    border: var(--border-width) solid var(--color-border);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }

  .variant-picker__pill:hover {
    border-color: var(--color-primary);
  }

  .variant-picker__input:checked + .variant-picker__pill {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-surface);
  }

  .variant-picker__input:focus-visible + .variant-picker__pill {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .variant-picker__pill.is-sold-out,
  .variant-picker__pill.is-unavailable {
    color: var(--color-text-light);
    text-decoration: line-through;
  }

  .variant-picker__pill.is-unavailable {
    border-style: dashed;
  }

  .variant-picker__input:checked + .variant-picker__pill.is-sold-out,
  .variant-picker__input:checked + .variant-picker__pill.is-unavailable {
    color: var(--color-surface);
  }

  /* Request in flight: dim the blocks that are about to change */
  .variant-picker.htmx-request ~ * .price,
  .htmx-request .variant-picker__values {
    opacity: 0.6;
    transition: opacity var(--transition-fast);
  }

  .variant-meta {
    display: flex;
    gap: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .variant-meta__stock--out { color: var(--color-error); }

  /* Buy buttons */
  .product-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .product-form__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .product-form__label {
    font-weight: var(--font-weight-medium);
    font-size: var(--text-sm);
  }

  .product-form__input {
    padding: var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius-sm);
    font-size: var(--text-base);
    max-width: 8rem;
  }

  .product-form__button {
    padding: var(--space-md);
    background: var(--color-primary);
    color: var(--color-surface);
    border-radius: var(--border-radius-md);
    font-weight: var(--font-weight-semibold);
    transition: background var(--transition-fast);
  }

  .product-form__button:hover {
    background: var(--color-primary-hover);
  }

  .product-form__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Gallery */
  .gallery-main {
    position: relative;
    aspect-ratio: 1;
    background: var(--color-surface-alt);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    margin-bottom: var(--space-md);
  }

  .gallery-main__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: var(--space-sm);
  }

  .gallery-thumb {
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color var(--transition-fast);
  }

  .gallery-thumb:hover,
  .gallery-thumb.active {
    border-color: var(--color-primary);
  }
</style>
