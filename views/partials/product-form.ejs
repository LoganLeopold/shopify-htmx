<style>
  .product-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  
  .product-form__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  
  .product-form__label {
    font-weight: var(--font-weight-medium);
    font-size: var(--text-sm);
  }
  
  .product-form__select,
  .product-form__input {
    padding: var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius-sm);
    font-size: var(--text-base);
  }
  
  .product-form__button {
    padding: var(--space-md);
    background: var(--color-primary);
    color: var(--color-surface);
    border-radius: var(--border-radius-md);
    font-weight: var(--font-weight-semibold);
    transition: background var(--transition-fast);
  }
  
  .product-form__button:hover {
    background: var(--color-primary-hover);
  }
  
  .product-form__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>

<form class="product-form"
      hx-post="/cart/add"
      hx-target="#cart-drawer-container"
      hx-swap="innerHTML"
      hx-on::after-request="document.querySelector('cart-drawer').setAttribute('open', '')">
  
  <% if (product.variants && product.variants.length > 1) { %>
    <div class="product-form__group">
      <label for="variantId" class="product-form__label">Variant</label>
      <select name="variantId" 
              id="variantId"
              class="product-form__select"
              required
              hx-get="/products/<%= product.handle %>/variant-details"
              hx-target="#product-price"
              hx-trigger="change"
              hx-include="#variantId">
        <% product.variants.forEach(variant => { %>
          <option value="<%= variant.id %>" 
                  <%= !variant.availableForSale ? 'disabled' : '' %>
                  <%= product.variants[0].id === variant.id ? 'selected' : '' %>>
            <%= variant.title %> 
            <% if (!variant.availableForSale) { %> - Out of Stock<% } %>
          </option>
        <% }) %>
      </select>
    </div>
  <% } else if (product.variants && product.variants.length === 1) { %>
    <input type="hidden" 
           name="variantId" 
           value="<%= product.variants[0].id %>">
  <% } %>
  
  <div class="product-form__group">
    <label for="quantity" class="product-form__label">Quantity</label>
    <input type="number" 
           name="quantity" 
           id="quantity"
           value="1" 
           min="1"
           class="product-form__input"
           required>
  </div>
  
  <button type="submit" 
          class="product-form__button"
          <%= product.variants && product.variants[0] && !product.variants[0].availableForSale ? 'disabled' : '' %>>
    Add to Cart
  </button>
</form>
