<%#
  Product page = sections, like a Shopify JSON template:
    main-product             rendered inline (and re-rendered on variant change)
    product-recommendations  lazy-loaded via the Section Rendering API
%>
<div id="shopify-section-main-product" class="shopify-section">
  <%- include('../sections/main-product', { sectionId: 'main-product' }) %>
</div>

<div id="shopify-section-product-recommendations"
     class="shopify-section"
     hx-get="/recommendations/products?product_id=<%= legacyId(product.id) %>&limit=4&section_id=product-recommendations"
     hx-trigger="revealed"
     hx-target="this"
     hx-swap="outerHTML"></div>
